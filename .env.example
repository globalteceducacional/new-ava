# AVA — variáveis de ambiente (desenvolvimento)
# Copie para .env:  copy .env.example .env

# --- Postgres ---
POSTGRES_USER=ava
POSTGRES_PASSWORD=ava_dev_password
POSTGRES_DB=ava
POSTGRES_PORT=5432
# App (local sem PgBouncer). connection_limit limita o pool Prisma por processo.
DATABASE_URL=postgresql://ava:ava_dev_password@localhost:5432/ava?schema=public&connection_limit=10
# Migrations / Prisma CLI — mesma URL local (em prod aponta ao Postgres direto).
DIRECT_URL=postgresql://ava:ava_dev_password@localhost:5432/ava?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=ava_minio
MINIO_ROOT_PASSWORD=ava_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=ava_minio
MINIO_SECRET_KEY=ava_minio_secret
MINIO_BUCKET=ava-media
MINIO_USE_SSL=false

# --- Mídia / upload ---
MEDIA_MAX_UPLOAD_BYTES=1073741824
MEDIA_TRANSCODE_CONCURRENCY=1
MEDIA_PLAYBACK_TOKEN_TTL=5m
# Offload HLS: segmentos direto no MinIO (recomendado). Vazio = Nest faz proxy (legado).
# Local (apps na máquina + MinIO Docker):
MEDIA_PUBLIC_BASE_URL=http://localhost:9000
# Produção (Caddy): https://seu-dominio/media-cdn

# --- Rate limit global (Throttler) ---
# Local: storage em memória (padrão). Produção: redis automático (NODE_ENV=production).
# Force: THROTTLE_STORAGE=redis | memory
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
CATALOG_CACHE_TTL_SEC=60

# --- Login proteção (Redis) ---
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_IP_RATE_LIMIT=30
LOGIN_IP_RATE_WINDOW_SEC=300

# --- Auth ---
JWT_SECRET=change-me-in-production-dev-only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Senha dos usuários do seed (npm run db:seed)
SEED_PASSWORD=123456

# --- Apps ---
API_PORT=3000
WEB_PORT=3001
WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
