# AVA — exemplo de ambiente de PRODUÇÃO / homologação
# 1) Copie:  copy .env.prod.example .env.prod
# 2) Gere segredos:  powershell -File .\scripts\gen-prod-secrets.ps1
#    (ou: bash scripts/gen-prod-secrets.sh)
# 3) Ajuste AVA_DOMAIN / URLs para o domínio real
# 4) Suba com --scale api=N (ver API_REPLICAS abaixo)
#
# NÃO versionar .env.prod

# ---------------------------------------------------------------------------
# Domínio e proxy
# ---------------------------------------------------------------------------
# Domínio público
AVA_DOMAIN=ava.exemplo.com.br
#
# Modo A — Caddy no compose (VPS só com o AVA): use só docker-compose.prod.yml
#   HTTP_PORT / HTTPS_PORT / CADDY_ACME_EMAIL entram em jogo.
# Modo B — nginx do host (Hostinger com vários sites): use também
#   docker-compose.prod.behind-nginx.yml + deploy/nginx-ava.conf.example
#   (Caddy NÃO sobe; HTTPS fica no nginx/certbot)
HTTP_PORT=80
HTTPS_PORT=443
CADDY_ACME_EMAIL=ops@suaempresa.com.br

# Origens / URLs públicas — DEVEM usar o mesmo host de AVA_DOMAIN
WEB_ORIGIN=https://ava.exemplo.com.br
NEXT_PUBLIC_API_URL=https://ava.exemplo.com.br/api

# Offload HLS: mesmo domínio + path /media-cdn (proxy → MinIO)
# Obrigatório em produção. Troque o host junto com AVA_DOMAIN.
MEDIA_PUBLIC_BASE_URL=https://ava.exemplo.com.br/media-cdn
# Emergência: false = segmentos passam pela API (mais lento, sem 403 do CDN)
# MEDIA_HLS_OFFLOAD=true

# Portas no host (só modo behind-nginx; bind em 127.0.0.1)
# AVA_API_HOST_PORT=3000
# AVA_WEB_HOST_PORT=3001
# AVA_MINIO_HOST_PORT=9000

# ---------------------------------------------------------------------------
# Segredos (gere com scripts/gen-prod-secrets — NÃO use os valores de exemplo)
# ---------------------------------------------------------------------------
POSTGRES_USER=ava
POSTGRES_PASSWORD=TROQUE_SENHA_FORTE_DB
POSTGRES_DB=ava

REDIS_PASSWORD=TROQUE_SENHA_FORTE_REDIS

MINIO_ACCESS_KEY=TROQUE_ACCESS_KEY
MINIO_SECRET_KEY=TROQUE_SECRET_KEY_FORTE
MINIO_BUCKET=ava-media

# Mínimo 32 caracteres aleatórios
JWT_SECRET=TROQUE_JWT_SECRET_LONGO_ALEATORIO_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Senha dos usuários criados no seed (aluno/professor/admin). Troque após o 1º login.
SEED_PASSWORD=TROQUE_SENHA_SEED_FORTE

# ---------------------------------------------------------------------------
# Auth / proteção / rate limit
# ---------------------------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# Rate limit de tentativas de login por IP (defaults no código se omitidos)
LOGIN_IP_RATE_LIMIT=30
LOGIN_IP_RATE_WINDOW_SEC=300
TRUST_PROXY=true
# Throttler global — em produção o storage é Redis (multi-réplica)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
THROTTLE_STORAGE=redis

# ---------------------------------------------------------------------------
# Escala (Postgres pool + API)
# ---------------------------------------------------------------------------
# Réplicas da API — use no up: --scale api=2 (Compose não aplica esta var sozinho)
API_REPLICAS=2
# Conexões Prisma por réplica (via PgBouncer). Total ≈ API_REPLICAS * PRISMA_CONNECTION_LIMIT
PRISMA_CONNECTION_LIMIT=5
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_POOL_SIZE=40
# Cache de catálogo/categorias (segundos)
CATALOG_CACHE_TTL_SEC=60

# ---------------------------------------------------------------------------
# Mídia
# ---------------------------------------------------------------------------
MEDIA_MAX_UPLOAD_BYTES=1073741824
MEDIA_DEFAULT_QUOTA_BYTES=10737418240
MEDIA_TRANSCODE_CONCURRENCY=1
MEDIA_PLAYBACK_TOKEN_TTL=5m

# ---------------------------------------------------------------------------
# Certificados (volume Docker em /data/certificates)
# ---------------------------------------------------------------------------
CERTIFICATES_DIR=/data/certificates

# ---------------------------------------------------------------------------
# Homologação local SEM DNS (opcional — comente o bloco de domínio real acima)
# ---------------------------------------------------------------------------
# AVA_DOMAIN=localhost
# CADDY_ACME_EMAIL=ops@localhost
# WEB_ORIGIN=http://localhost
# NEXT_PUBLIC_API_URL=http://localhost/api
# MEDIA_PUBLIC_BASE_URL=http://localhost/media-cdn
# HTTP_PORT=80
# HTTPS_PORT=443
# API_REPLICAS=1
